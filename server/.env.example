# Supabase Postgres connection string.
# IMPORTANT: use the "Session pooler" string (IPv4-compatible) — Render's outbound
# is IPv4-only and Supabase's direct connection is IPv6-only.
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> Session pooler
DATABASE_URL=postgresql://postgres.vsrdpobeockdyfwjkloi:[YOUR-DB-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# Your Supabase project URL (public, safe to commit in real config)
SUPABASE_URL=https://vsrdpobeockdyfwjkloi.supabase.co

# Optional: ONLY set if your project uses the legacy HS256 JWT secret.
# New Supabase projects sign JWTs with asymmetric keys verified via JWKS and do
# NOT need this. Leave unset unless JWT verification fails.
# SUPABASE_JWT_SECRET=

# Comma-separated allowed CORS origins for your web frontend. Default "*".
# ALLOWED_ORIGINS=https://your-web-app.com,http://localhost:5173

# Port — Render sets this automatically; used only for local dev.
PORT=8080
